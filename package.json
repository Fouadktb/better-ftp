{
  "name": "better-ftp",
  "private": true,
  "version": "0.1.0-alpha.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests e2e docs README.md *.ts *.json index.html",
    "format:check": "prettier --check src tests e2e docs README.md *.ts *.json index.html",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "test:release": "node --test scripts/sync-version.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@heroicons/react": "2.2.0",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.24.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fouadktb/better-ftp.git"
  }
}
